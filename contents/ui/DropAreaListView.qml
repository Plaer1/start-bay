pragma ComponentBehavior: Bound

import QtQuick

KickoffListView {
    id: root
    property alias orderController: dropArea.orderController
    property alias dropEnabled: dropArea.dropEnabled
    KickoffDropArea {
        id: dropArea
        z: -1
        parent: root
        anchors.fill: parent
        targetView: root.view
        scrollUpMargin: root.header.height * 2
        scrollDownMargin: root.footer.height * 2
    }
}
